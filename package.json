{
  "name": "celebrare-upi-payments",
  "version": "1.0.0",
  "description": "Direct UPI payment system for event photos",
  "main": "index.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install",
    "setup-db": "node backend/scripts/setupDatabase.js",
    "seed": "node backend/scripts/seed.js"
  },
  "keywords": ["upi", "payments", "photos"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.7",
    "mailparser": "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
